# Swagger UI available at: http://localhost:8080/swagger-ui.html
# OpenAPI JSON spec at:    http://localhost:8080/v3/api-docs

springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.operationsSorter=alpha
springdoc.swagger-ui.tagsSorter=alpha
springdoc.swagger-ui.try-it-out-enabled=true

# Group the endpoints so they appear in logical sections
springdoc.group-configs[0].group=Authentication
springdoc.group-configs[0].paths-to-match=/auth/**

springdoc.group-configs[1].group=Courses
springdoc.group-configs[1].paths-to-match=/courses/**

springdoc.group-configs[2].group=Lessons
springdoc.group-configs[2].paths-to-match=/lessons/**

springdoc.group-configs[3].group=Quizzes
springdoc.group-configs[3].paths-to-match=/quizzes/**,/quiz-attempts/**

springdoc.group-configs[4].group=Progress & Certificates
springdoc.group-configs[4].paths-to-match=/progress/**,/api/certificates/**

springdoc.group-configs[5].group=Enrollments & Payments
springdoc.group-configs[5].paths-to-match=/enrollments/**,/payments/**,/subscriptions/**

springdoc.group-configs[6].group=Teacher Applications
springdoc.group-configs[6].paths-to-match=/teacher-applications/**